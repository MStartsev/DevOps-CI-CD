# Django Application - Environment Variables

# Скопіювати цей файл: cp .env.example .env
# Заповнити реальними значеннями. НЕ комітити .env у git!

# Тільки секрети - решта змінних у values.yaml -> ConfigMap
DJANGO_SECRET_KEY=your-50-char-secret-key----change-me-in-production
DJANGO_DEBUG=False
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_HOST=postgres-postgresql
POSTGRES_PORT=5432